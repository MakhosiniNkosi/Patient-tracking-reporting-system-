// Patient Tracking & Reporting System — Prisma schema
// Modeled on the DSD AHF Contribution Monthly Report + Clinicians' Index
// Testing Referral List forms.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
}

enum UserRole {
  CAPTURER
  VERIFIER
  PROGRAM_MANAGER
  ADMIN
  VIEWER // read-only, system-wide oversight — a former ADMIN lands here
  // after appointing a successor; never directly assignable via
  // the normal "Add user" flow, only via the appoint-admin handoff
}

enum UnitType {
  COUNT
  PERCENT
  RATE_PER_DAY
  RATE_PER_WEEK
}

model Facility {
  id           String   @id @default(uuid())
  name         String
  facilityCode String   @unique
  district     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  monthlyReports   MonthlyReport[]
  weeklyReports    WeeklyReport[]
  indexTestingLogs IndexTestingReferral[]

  @@map("facilities")
}

model PerformanceCycle {
  id        String   @id @default(uuid())
  label     String   @unique // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime

  monthlyReports   MonthlyReport[]
  weeklyReports    WeeklyReport[]
  indicatorTargets IndicatorTarget[]

  @@map("performance_cycles")
}

model Indicator {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "PREP_STARTED"
  label     String // e.g. "# of clients started on PrEP"
  unitType  UnitType @default(COUNT)
  sortOrder Int      @default(0)

  monthlyEntries   MonthlyReportEntry[]
  weeklyEntries    WeeklyReportEntry[]
  indicatorTargets IndicatorTarget[]

  @@map("indicators")
}

model IndicatorTarget {
  id          String @id @default(uuid())
  indicatorId String
  cycleId     String
  targetValue String // free text to allow "1 per day", "100% eligible", "10 per week"

  indicator Indicator        @relation(fields: [indicatorId], references: [id])
  cycle     PerformanceCycle @relation(fields: [cycleId], references: [id])

  @@unique([indicatorId, cycleId])
  @@map("indicator_targets")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CAPTURER)
  facilityId   String?
  createdAt    DateTime @default(now())

  facility              Facility?       @relation(fields: [facilityId], references: [id])
  capturedReports       MonthlyReport[] @relation("CapturedBy")
  capturedWeeklyReports WeeklyReport[]  @relation("WeeklyCapturedBy")

  @@map("users")
}

model MonthlyReport {
  id           String       @id @default(uuid())
  facilityId   String
  cycleId      String
  month        String // "Oct" .. "Sep" matching the performance-cycle year
  status       ReportStatus @default(DRAFT)
  capturedById String?
  verifiedBy   String?
  verifiedDate DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  facility   Facility             @relation(fields: [facilityId], references: [id])
  cycle      PerformanceCycle     @relation(fields: [cycleId], references: [id])
  capturedBy User?                @relation("CapturedBy", fields: [capturedById], references: [id])
  entries    MonthlyReportEntry[]

  @@unique([facilityId, cycleId, month])
  @@map("monthly_reports")
}

model MonthlyReportEntry {
  id          String  @id @default(uuid())
  reportId    String
  indicatorId String
  value       Decimal @db.Decimal(10, 2)

  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  indicator Indicator     @relation(fields: [indicatorId], references: [id])

  @@unique([reportId, indicatorId])
  @@map("monthly_report_entries")
}

// One WeeklyReport per facility/cycle/month/week. Every save automatically
// syncs into the MonthlyReport's running totals — see
// WeeklyReportsService.upsert for the delta logic: it compares this save's
// values against what the week previously held and adjusts the monthly
// entries by the *difference*, so editing a week (not just creating one)
// keeps the monthly total correct instead of double-counting.
model WeeklyReport {
  id           String             @id @default(uuid())
  facilityId   String
  cycleId      String
  month        String // the month this week rolls up into, e.g. "Jul"
  weekLabel    String // e.g. "Week 1", "06-12 Jul"
  status       WeeklyReportStatus @default(DRAFT)
  capturedById String?
  lastSyncedAt DateTime? // set every time this week's values are synced into the monthly report
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  facility   Facility            @relation(fields: [facilityId], references: [id])
  cycle      PerformanceCycle    @relation(fields: [cycleId], references: [id])
  capturedBy User?               @relation("WeeklyCapturedBy", fields: [capturedById], references: [id])
  entries    WeeklyReportEntry[]

  @@unique([facilityId, cycleId, month, weekLabel])
  @@map("weekly_reports")
}

model WeeklyReportEntry {
  id          String  @id @default(uuid())
  reportId    String
  indicatorId String
  // Defaults to 0 — every indicator gets a row for every week even if the
  // capturer left the field blank, so an untouched line is an explicit
  // zero, not a missing value that would silently skip the monthly total.
  value       Decimal @default(0) @db.Decimal(10, 2)

  report    WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  indicator Indicator    @relation(fields: [indicatorId], references: [id])

  @@unique([reportId, indicatorId])
  @@map("weekly_report_entries")
}

model IndexTestingReferral {
  id          String   @id @default(uuid())
  facilityId  String
  date        DateTime
  fileNo      String
  riskReasons String[] // e.g. ["UNSUPPRESSED_VL", "NEW_STI", "RE_ENGAGEMENT"]
  otherRisk   String?
  receivedBy  String // counsellor name
  completedBy String?
  createdAt   DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@map("index_testing_referrals")
}
